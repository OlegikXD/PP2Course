* {
    font-family: 'Segoe UI', 'Arial', sans-serif;
}

QWidget {
    background-color: #0f0f1a;
}

QLabel#city_label {
    font-size: 22px;
    font-weight: 600;
    color: #e8e8f0;
    padding: 10px 0 5px 0;
    letter-spacing: 0.5px;
}

QLineEdit#city_input {
    font-size: 18px;
    background: #1a1a2e;
    color: #e8e8f0;
    border: 2px solid #2a2a40;
    border-radius: 12px;
    padding: 12px 20px;
    margin: 5px 0 15px 0;
    min-height: 25px;
    transition: all 0.3s;
}

QLineEdit#city_input:focus {
    border-color: #7c73ff;
    background: #1e1e35;
    box-shadow: 0 0 0 4px rgba(108, 99, 255, 0.2);
}

QLineEdit#city_input:hover {
    border-color: #3a3a55;
}

QPushButton#get_weather_button,
QPushButton#get_5days_weather_button {
    font-size: 16px;
    font-weight: 600;
    color: white;
    border: none;
    border-radius: 12px;
    padding: 14px 20px;
    margin: 5px 5px 10px 5px;
    min-height: 30px;
    transition: all 0.3s ease;
}

QPushButton#get_weather_button {
    background: qlineargradient(x1: 0, y1: 0, x2: 1, y2: 0,
        stop: 0 #6c63ff, stop: 1 #5a52d5);
}

QPushButton#get_weather_button:hover {
    background: qlineargradient(x1: 0, y1: 0, x2: 1, y2: 0,
        stop: 0 #7c73ff, stop: 1 #6a62e5);
    transform: scale(1.02);
    box-shadow: 0 4px 20px rgba(108, 99, 255, 0.5);
}

QPushButton#get_weather_button:pressed {
    background: qlineargradient(x1: 0, y1: 0, x2: 1, y2: 0,
        stop: 0 #5a52d5, stop: 1 #4a42c5);
    transform: scale(0.98);
}

QPushButton#get_5days_weather_button {
    background: qlineargradient(x1: 0, y1: 0, x2: 1, y2: 0,
        stop: 0 #00b894, stop: 1 #00a381);
}

QPushButton#get_5days_weather_button:hover {
    background: qlineargradient(x1: 0, y1: 0, x2: 1, y2: 0,
        stop: 0 #00c9a0, stop: 1 #00b391);
    transform: scale(1.02);
    box-shadow: 0 4px 20px rgba(0, 184, 148, 0.5);
}

QPushButton#get_5days_weather_button:pressed {
    background: qlineargradient(x1: 0, y1: 0, x2: 1, y2: 0,
        stop: 0 #00a381, stop: 1 #009371);
    transform: scale(0.98);
}

QLabel#weather_display {
    background: #1a1a2e;
    border-radius: 16px;
    padding: 25px;
    margin: 10px;
    min-height: 200px;
    color: #e8e8f0;
    border: 1px solid rgba(255, 255, 255, 0.05);
    box-shadow: 0 2px 20px rgba(0, 0, 0, 0.4);
}

QPushButton#settings_button {
    font-size: 15px;
    font-weight: 500;
    background: #1a1a2e;
    color: #e8e8f0;
    border: 2px solid #2a2a40;
    border-radius: 12px;
    padding: 12px 20px;
    margin: 5px 0 0 0;
    min-height: 25px;
    transition: all 0.3s;
}

QPushButton#settings_button:hover {
    background: #22223a;
    border-color: #7c73ff;
    color: #7c73ff;
    box-shadow: 0 2px 15px rgba(108, 99, 255, 0.2);
}

QPushButton#settings_button:pressed {
    background: #0a0a15;
    transform: scale(0.98);
}

QScrollArea {
    border: none;
    border-radius: 16px;
    background: transparent;
    margin: 5px 0;
}

QScrollArea > QWidget > QWidget {
    background: transparent;
}

QScrollBar:vertical {
    border: none;
    background: rgba(255, 255, 255, 0.05);
    width: 8px;
    border-radius: 4px;
    margin: 4px;
}

QScrollBar::handle:vertical {
    background: qlineargradient(x1: 0, y1: 0, x2: 1, y2: 0,
        stop: 0 #6c63ff, stop: 1 #5a52d5);
    border-radius: 4px;
    min-height: 30px;
    transition: all 0.3s;
}

QScrollBar::handle:vertical:hover {
    background: qlineargradient(x1: 0, y1: 0, x2: 1, y2: 0,
        stop: 0 #7c73ff, stop: 1 #6a62e5);
    width: 10px;
}

QScrollBar::handle:vertical:pressed {
    background: qlineargradient(x1: 0, y1: 0, x2: 1, y2: 0,
        stop: 0 #5a52d5, stop: 1 #4a42c5);
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    border: none;
    background: none;
    height: 0px;
}

QScrollBar::corner {
    background: transparent;
}

QDialog {
    background: #1a1a2e;
    border-radius: 16px;
}

QDialog QLabel {
    color: #e8e8f0;
    font-size: 14px;
    font-weight: 500;
    padding: 5px 0;
}

QDialog QRadioButton {
    color: #e8e8f0;
    font-size: 14px;
    padding: 8px 5px;
    border-radius: 8px;
    transition: all 0.3s;
}

QDialog QRadioButton:hover {
    background: rgba(108, 99, 255, 0.1);
}

QDialog QRadioButton::indicator {
    width: 20px;
    height: 20px;
    border-radius: 10px;
}

QDialog QRadioButton::indicator:unchecked {
    background: #0f0f1a;
    border: 2px solid #3a3a55;
}

QDialog QRadioButton::indicator:checked {
    background: #6c63ff;
    border: 2px solid #6c63ff;
}

QDialog QRadioButton::indicator:checked:hover {
    background: #7c73ff;
    border-color: #7c73ff;
}

QDialog QPushButton {
    font-size: 14px;
    font-weight: 600;
    color: white;
    background: qlineargradient(x1: 0, y1: 0, x2: 1, y2: 0,
        stop: 0 #6c63ff, stop: 1 #5a52d5);
    border: none;
    border-radius: 10px;
    padding: 10px 25px;
    min-height: 30px;
    min-width: 80px;
    transition: all 0.3s;
}

QDialog QPushButton:hover {
    background: qlineargradient(x1: 0, y1: 0, x2: 1, y2: 0,
        stop: 0 #7c73ff, stop: 1 #6a62e5);
    box-shadow: 0 4px 20px rgba(108, 99, 255, 0.4);
}

QDialog QPushButton:pressed {
    transform: scale(0.96);
}

QDialog QPushButton#cancel_button {
    background: #2a2a40;
    color: #b0b0c0;
}

QDialog QPushButton#cancel_button:hover {
    background: #3a3a55;
    box-shadow: none;
}